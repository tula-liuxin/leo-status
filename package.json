{
  "name": "leo-status",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Leo 状态看板与阿源：笔记和真实用户承诺先确认再追踪，多设备共用建议、对话与记忆。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "scan.js",
    "settings.js",
    "sync.js",
    "hub.js",
    "edit.js",
    "suggest.js",
    "yuan.js",
    "yuan-agent.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT-V4.md",
    "intake.js",
    "CONTRACT-V5.md",
    "memory-core.js",
    "hub-memory.js",
    "ayuan-state.js",
    "yuan-context.js",
    "CONTRACT-V6.md",
    "CONTRACT-V7.md",
    "CONTRACT-V8.md",
    "CONTRACT-V9.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "todo",
    "status",
    "obsidian",
    "multi-device",
    "yuan",
    "agent"
  ],
