{
  "name": "leo-status",
  "version": "2.3.3",
  "private": false,
  "type": "module",
  "description": "Leo 的时间轴、富文本笔记与层级待办，本机中心存储",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "settings.js",
    "sync.js",
    "hub.js",
    "edit.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD-PARTY-NOTICES.txt",
    "CONTRACT.md",
    "HISTORY-0.x.md",
    "notes.js",
    "notes-http.js",
    "notes-titles.js",
    "relay.js",
    "THIRD-PARTY-LICENSES.txt",
    "tags.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "todo",
    "status",
    "multi-device"
  ],
  "author": {
    "name": "leo",
    "url": "https://github.com/tula-liuxin"
  },
  "license": "MIT",
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/notes.test.mjs test/notes-host.test.mjs test/hub-route-lifecycle.test.mjs test/polish-backend.test.mjs test/editor-*.test.mjs test/features-integration.test.mjs test/tags.test.mjs test/note-move.test.mjs test/note-navigation.test.mjs test/inline-new.test.mjs test/recording-errors.test.mjs test/title-structure.test.mjs test/image-attachments.test.mjs"
  }
}
