{
  "name": "leo-status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Leo 待办看板：Obsidian 待办自动展示，会话与笔记候选确认后追踪，多设备中心同步。阿源已拆分为独立的 ayuan 包。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "scan.js",
    "settings.js",
    "sync.js",
    "hub.js",
    "edit.js",
    "suggest.js",
    "intake.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "todo",
    "status",
    "obsidian",
    "multi-device"
  ],
  "author": {
